{
  "name": "@hmcts/opal-frontend-common-cypress",
  "version": "0.0.3",
  "description": "Shared Cypress runner, reporting, browser, and metadata tooling for OPAL frontend applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmcts/opal-frontend-common-cypress-lib.git"
  },
  "bugs": {
    "url": "https://github.com/hmcts/opal-frontend-common-cypress-lib/issues"
  },
  "homepage": "https://github.com/hmcts/opal-frontend-common-cypress-lib#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "opal-cypress-build-component-report": "./dist/bin/build-component-report.js",
    "opal-cypress-build-cucumber-report": "./dist/bin/build-cucumber-report.js",
    "opal-cypress-check-jira-test-metadata": "./dist/bin/check-cypress-test-metadata.js",
    "opal-cypress-check-new-tests-jira-metadata": "./dist/bin/check-new-tests-jira-metadata.js",
    "opal-cypress-check-test-metadata": "./dist/bin/check-cypress-test-metadata.js",
    "opal-cypress-extract-jira-test-keys": "./dist/bin/extract-jira-test-keys.js",
    "opal-cypress-find-duplicate-scenarios": "./dist/bin/find-duplicate-scenarios.js",
    "opal-cypress-find-tests-missing-epic": "./dist/bin/find-tests-missing-epic.js",
    "opal-cypress-find-tests-with-multiple-epics": "./dist/bin/find-tests-with-multiple-epics.js",
    "opal-cypress-find-unused-steps": "./dist/bin/find-unused-steps.js",
    "opal-cypress-resolve-placeholder-jira-epics": "./dist/bin/resolve-placeholder-jira-epics.js",
    "opal-cypress-runner": "./dist/bin/run-test-suite.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "prepack": "yarn build",
    "pack:local": "find . -maxdepth 1 -type f -name 'hmcts-opal-frontend-common-cypress-*.tgz' -delete && npm_config_cache=${TMPDIR:-/tmp}/npm-cache-opal-common-cypress npm pack",
    "pack:check": "node scripts/validate-pack-shape.cjs",
    "pack:dry-run": "npm_config_cache=${TMPDIR:-/tmp}/npm-cache-opal-common-cypress npm pack --dry-run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@badeball/cypress-cucumber-preprocessor": ">=18 <27",
    "cypress": ">=12 <16",
    "cypress-mochawesome-reporter": ">=3 <6",
    "cypress-multi-reporters": ">=1 <3",
    "cypress-parallel": ">=0.14 <1",
    "junit-report-merger": ">=7 <10",
    "mocha-junit-reporter": ">=2 <3",
    "mochawesome": ">=7 <9",
    "mochawesome-merge": ">=4 <6",
    "mochawesome-report-generator": ">=6 <7",
    "typescript": ">=5 <8"
  },
  "peerDependenciesMeta": {
    "@badeball/cypress-cucumber-preprocessor": {
      "optional": true
    },
    "cypress": {
      "optional": true
    },
    "cypress-mochawesome-reporter": {
      "optional": true
    },
    "cypress-multi-reporters": {
      "optional": true
    },
    "cypress-parallel": {
      "optional": true
    },
    "junit-report-merger": {
      "optional": true
    },
    "mocha-junit-reporter": {
      "optional": true
    },
    "mochawesome": {
      "optional": true
    },
    "mochawesome-merge": {
      "optional": true
    },
    "mochawesome-report-generator": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.18.0"
}
